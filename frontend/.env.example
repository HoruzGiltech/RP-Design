# Copia este archivo como ".env" dentro de frontend/.
# OJO: todo lo que empieza con VITE_ termina en el navegador y es PÚBLICO.
# Aquí nunca va una clave ni un secreto.

# Dirección de la API del backend, sin barra al final
VITE_API_URL=http://localhost:8000/api

# Título de la pestaña mientras carga el sitio (después se usa el del panel)
VITE_SITE_NAME=RP Diseño Interior
