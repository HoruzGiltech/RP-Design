# Copia este archivo como ".env" y cambia los valores.
# El archivo .env NO se sube al repositorio.

# Django
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_URL=panel-rp/
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Solo en producción (DJANGO_DEBUG=False). En local se dejan así.
# Dominios desde los que se aceptan formularios del panel, con https://
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=31536000

# Base de datos
# Los tres POSTGRES_* crean la base en Docker; DATABASE_URL es la que usa Django.
# Si cambias uno, cambia también el otro.
POSTGRES_USER=rp
POSTGRES_PASSWORD=rp
POSTGRES_DB=rpdesign
DATABASE_URL=postgres://rp:rp@db:5432/rpdesign

# Límites
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50
THROTTLE_PUBLIC=120/min
THROTTLE_QUOTES=5/hour

# Almacenamiento (producción)
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
